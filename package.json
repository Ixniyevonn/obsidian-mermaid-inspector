{
  "name": "obsidian-mermaid-inspector",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write ./src",
    "lint": "biome lint --apply-unsafe ./src"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "svelte-pan-zoom": "^0.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.5.0",
    "builtin-modules": "^5.0.0",
    "bun-types": "^1.3.11",
    "obsidian": "^1.12.3",
    "svelte": "^5.54.1",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}

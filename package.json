    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.5.0",
    "builtin-modules": "^5.0.0",
    "bun-types": "^1.3.11",
    "jsdom": "^29.1.1",
    "obsidian": "^1.12.3",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"

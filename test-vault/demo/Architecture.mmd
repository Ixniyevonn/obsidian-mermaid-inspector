flowchart TD
  Client[Browser / Mobile] --> Edge

  subgraph Edge ["Edge / CDN"]
    Gateway[API Gateway] --> RateLimit[Rate Limiter]
    Gateway --> AuthEdge[Edge Auth]
  end

  subgraph Core ["Core Domain"]
    Gateway --> CoreRouter[Router]
    CoreRouter --> Billing
    CoreRouter --> Catalog

    subgraph Billing
      B1[Invoices] --> B2[Payments]
    end

    subgraph Catalog
      C1[Products] --> C2[Search]
      C2 --> C3[Recommendations]
    end
  end

  subgraph Data ["Data Layer"]
    Core --> DB[(Postgres)]
    Core --> Cache[(Redis)]
    Catalog --> SearchIndex[(Elasticsearch)]
  end

  Billing --> Data
  Catalog --> Data

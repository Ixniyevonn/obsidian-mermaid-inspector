stateDiagram-v2
  [*] --> Booting
  Booting --> Running : boot complete

  state Running {
    Running --> Services : start services
    state Services {
      Auth --> API
      API --> Workers
      Workers --> DB
    }
    Services --> Healthy : all green
    Healthy --> Degraded : incident
    Degraded --> Healthy : recovered
  }

  Running --> Shutdown : SIGTERM
  Shutdown --> [*]
